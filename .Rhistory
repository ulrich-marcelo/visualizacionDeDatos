library(eph)
library(ggplot2)
library(dplyr)
library(forcats)
library(tidyr)
library(ggridges)
knitr::opts_chunk$set(message = FALSE, warning = FALSE, comment = "")
options(scipen = 999)
eph_df <- data_hogar
# 1. Contar la frecuencia de cada categoría de IV6, ponderado
agua_df <- eph_df %>%
group_by(IV6) %>%
summarise(
count = sum(Pondera, na.rm = TRUE)
)
eph_hogar_1t <- get_microdata(year = 2024, trimester = 1, type = 'hogar')
eph_hogar_2t <- get_microdata(year = 2024, trimester = 2, type = 'hogar')
eph_hogar_3t <- get_microdata(year = 2024, trimester = 3, type = 'hogar')
data_hogar <- rbind(eph_hogar_1t, eph_hogar_2t, eph_hogar_3t)
data_hogar <- organize_labels(data, type = "hogar")
data_hogar
cols(data_hogar)
data_hogar.cols
colnames(data_hogar)
# Filtra las categorías que no son relevantes para el análisis
# y elimina registros con valores de edad o estado faltantes
plot_df <- data %>%
filter(!is.na(ESTADO) & !is.na(CH06) & ESTADO != "Menor de 10 años")
# 2. Crear el gráfico de enjambre de abejas
ggplot(plot_df, aes(x = ESTADO, y = CH06, size = Pondera, color = ESTADO)) +
# Usar geom_beeswarm para crear el gráfico de enjambre.
# El parámetro 'size' ajusta el tamaño del punto según el ponderador.
geom_beeswarm(alpha = 0.6, cex = 1.5, show.legend = FALSE) +
# 3. Personalizar el gráfico
labs(
title = "Distribución de la Edad por Condición de Actividad (EPH 2024)",
subtitle = "Cada punto representa una persona, con tamaño ajustado por el ponderador",
x = "Condición de Actividad",
y = "Edad (en años)"
) +
theme_minimal() +
theme(
# Mejora el título
plot.title = element_text(hjust = 0.5, face = "bold"),
plot.subtitle = element_text(hjust = 0.5)
)
