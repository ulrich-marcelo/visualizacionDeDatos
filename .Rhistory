# ----------------------------
# Waffle 1: Estructura (ESTADO)
# ----------------------------
estado_labs <- c(
`1` = "Ocupado",
`2` = "Desocupado",
`3` = "Inactivo"
)
df1 <- eph10 |>
dplyr::filter(ESTADO %in% c(1,2,3)) |>
dplyr::mutate(estado = forcats::fct_recode(as.factor(ESTADO),
!!!setNames(estado_labs, names(estado_labs)))) |>
dplyr::group_by(estado) |>
dplyr::summarise(n = sum(.data[[wvar]]), .groups = "drop") |>
dplyr::mutate(p = n / sum(n))
colnames(data)
# ---- Treemap Idea 1: No laborales por DECCFR -------------------------------
# install.packages("treemapify")
library(treemapify)
# ---- Treemap Idea 1: No laborales por DECCFR -------------------------------
# install.packages("treemapify")
library(treemap)
library(dplyr)
library(tidyr)
library(ggplot2)
nonlab_vars <- c(
"V2_M","V3_M","V4_M","V5_M","V8_M","V9_M","V10_M",
"V11_M","V12_M","V18_M","V19_AM","V21_M"
)
fuente_labels <- c(
V2_M   = "Jubilación/Pensión",
V3_M   = "Indemnización por despido",
V4_M   = "Seguro de desempleo",
V5_M   = "Subsidios/Ayudas en dinero",
V8_M   = "Alquileres",
V9_M   = "Ganancias sin trabajar",
V10_M  = "Intereses/Rentas",
V11_M  = "Beca",
V12_M  = "Cuotas alimentos/Ayuda",
V18_M  = "Otros en efectivo",
V19_AM = "Trabajo de menores <10",
V21_M  = "Aguinaldo"
)
treemap_nonlab <- data %>%
# deciles válidos 1:10 (DECCFR viene en personas)
dplyr::filter(DECCFR %in% as.character(1:10)) %>%
dplyr::select(DECCFR, PONDII, dplyr::all_of(nonlab_vars)) %>%
tidyr::pivot_longer(cols = dplyr::all_of(nonlab_vars),
names_to = "fuente", values_to = "monto") %>%
# -9 = NR en ingresos
dplyr::mutate(monto = ifelse(monto < 0, NA_real_, monto)) %>%
tidyr::drop_na(monto, PONDII) %>%
dplyr::group_by(DECCFR, fuente) %>%
dplyr::summarise(total = sum(monto * PONDII, na.rm = TRUE), .groups = "drop") %>%
dplyr::mutate(
fuente = dplyr::recode(fuente, !!!fuente_labels),
DECCFR = factor(DECCFR, levels = as.character(1:10), ordered = TRUE)
)
View(data)
